<%
  DART_TYPES = { :uint => 'int', :int => 'int', :string => 'String', :boolean => 'bool' }
  WRITE_CALLS = { :uint => 'writeUint', :int => 'writeInt', :string => 'writeString', :boolean => 'writeBool' }
  STRUCTURAL = ['Timestamp', 'Length']

  # Only messages the tracker itself emits carry the structural `Length`
  # attribute. That filter drops the server-produced MobileSessionStart/End
  # (90/91), MobilePerformanceAggregated (110, :swift => false) and
  # MobileIssueEvent (111), none of which the mobile SDKs send.
  emitted = $messages.select do |m|
    m.context == :ios && m.swift && m.attributes.any? { |a| a.name == 'Length' }
  end

  classes = emitted.map do |msg|
    fields = msg.attributes.reject { |a| STRUCTURAL.include?(a.name) }
    cls = 'OR' + msg.name
    names = fields.map { |f| f.name.camel_case }

    lines = []
    lines << "/// #{msg.name} (#{msg.id})"
    lines << "class #{cls} extends ORMessage {"
    lines << "  #{cls}({"
    names.each { |n| lines << "    required this.#{n}," }
    lines << '    int? timestamp,'
    lines << "  }) : super(#{msg.id}, timestamp);"
    lines << ''
    fields.each_with_index do |f, i|
      lines << "  final #{DART_TYPES[f.type]} #{names[i]};"
    end
    lines << ''
    lines << '  @override'
    lines << '  Uint8List body() {'
    lines << '    final w = MessageWriter();'
    fields.each_with_index do |f, i|
      lines << "    w.#{WRITE_CALLS[f.type]}(#{names[i]});"
    end
    lines << '    return w.takeBytes();'
    lines << '  }'
    lines << ''
    desc = names.map { |n| " #{n}:$#{n}" }.join
    lines << '  @override'
    lines << "  String toString() =>"
    lines << "      '-->> #{msg.name}(#{msg.id}): timestamp:$timestamp#{desc}';"
    lines << '}'
    lines.join("\n")
  end
%>
// Auto-generated by mobs/run.rb from mobs/mobile_messages.rb - do not edit.

import 'dart:typed_data';

import 'message.dart';
import 'writer.dart';

<%= classes.join("\n\n") %>
