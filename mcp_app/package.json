{
  "name": "openreplay-mcp-app",
  "version": "1.0.7",
  "description": "OpenReplay MCP App - View charts and session replays from your OpenReplay instance",
  "main": "server.ts",
  "scripts": {
    "build": "npm run typecheck && npm run build:ui && npm run build:server",
    "build:ui": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.mjs --packages=external",
    "serve": "tsx server.ts",
    "dev": "npm run build && npm run serve",
    "typecheck": "node scripts/typecheck.mjs"
  },
  "keywords": [
    "mcp",
    "openreplay",
    "charts",
    "session-replay"
  ],
  "author": "OpenReplay (https://github.com/openreplay/openreplay/)",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/core": "^2.2.0",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/server": "^2.2.0",
    "@openreplay/player": "link:../player",
    "echarts": "^6.1.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
