{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "openreplay": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/server/server.mjs"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "MCP_WIDGET_DOMAIN": "https://openreplay.com"
      }
    }
  }
}
