# Local development environment for the Go backend (.dev/run-dev.sh <api|tasks>).
# Copy to backend/.env (git-ignored) and adjust: cp .dev/.env.dev .env
# Values below are placeholders for a local stack reached through port-forwards.

# ---- shared (api + tasks) ------------------------------------------------------
SERVICE_NAME='local-go'
POSTGRES_STRING='postgresql://postgres:postgres@127.0.0.1:5420/postgres'
CLICKHOUSE_STRING='127.0.0.1:8139'
CLICKHOUSE_HTTP_STRING='127.0.0.1:8138'
BUCKET_NAME=''
CH_COMPRESSION_ALGO='none'
CH_DEBUG='true'
PG_LOG_QUERIES='true'
DEBUG='true'

# ---- api (cmd/api) ----------------------------------------------------------------
HOSTNAME='local'
HTTP_PORT='8001'
FS_DIR='/tmp'
JWT_SECRET='change-me'
JWT_REFRESH_SECRET='change-me'
JWT_SPOT_SECRET='change-me'
JWT_SPOT_REFRESH_SECRET='change-me'
JWT_ALGORITHM='HS512'
JWT_ISSUER='openReplay-dev'
JWT_EXPIRATION='6000s'
JWT_REFRESH_EXPIRATION='60000'
JWT_SPOT_EXPIRATION='6000'
JWT_SPOT_REFRESH_EXPIRATION='604800'
ASSIST_URL='http://localhost:9001'
# REDIS_STRING='redis://127.0.0.1:6379'   # optional; api only warns when unreachable

# ---- tasks (cmd/tasks: crons) -----------------------------------------------------
SITE_URL='http://localhost:3333'
# "<name> <cron expr>, ..." ; alerts defaults to "* * * * *" (1-minute tick) when unset
CRON_SCHEDULES='alerts @every 30s'
CRON_DISABLED=''
# hosts allowed to bypass the SSRF guard for alert webhooks (local receivers)
ALERTS_WEBHOOK_ALLOWED_HOSTS='localhost,127.0.0.1'
# SMTP for alert e-mails; leave EMAIL_HOST empty to skip e-mail delivery
EMAIL_HOST=''
EMAIL_PORT='587'
EMAIL_USER=''
EMAIL_PASSWORD=''
EMAIL_USE_TLS='true'
EMAIL_USE_SSL='false'
EMAIL_FROM='OpenReplay<do-not-reply@openreplay.com>'
