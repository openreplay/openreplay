{
  "name": "openreplay",
  "version": "1.7.0",
  "license": "Apache-2.0",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./app/init/**",
    "./app/components/Charts/init.ts"
  ],
  "scripts": {
    "writeCommitHash": "node ./scripts/getCommitHash/getHash.js",
    "dev": "vite",
    "build": "bun run gen:icons && bun run gen:colors && vite build && bun run writeCommitHash",
    "preview": "vite preview --port 3333",
    "lint": "eslint app",
    "knip": "knip --reporter compact",
    "typecheck": "bun check",
    "gen:icons": "node ./scripts/icons.js",
    "gen:colors": "node ./scripts/colors.js",
    "gen:static": "bun run gen:icons && bun run gen:colors",
    "test:ci": "jest --maxWorkers=50% --coverage",
    "test": "jest --watch",
    "lint:fix": "eslint --fix app",
    "format": "prettier --write \"app/**/*.{ts,tsx,js,jsx,css,json}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,js,jsx,css,json}\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@codewonders/html2canvas": "^1.0.2",
    "@dicebear/core": "10.7.0",
    "@medv/finder": "^4.0.2",
    "@neodrag/react": "^2.3.1",
