{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Unused files and exports. Dependencies stay out: the player package
  // (../player via the Player alias) and the saas overlay bring their own.
  "rules": {
    "dependencies": "off",
    "devDependencies": "off",
    "optionalPeerDependencies": "off",
    "unlisted": "off",
    "unresolved": "off",
    "binaries": "off",
    "types": "off",
    "enumMembers": "off",
    "nsExports": "off",
    "nsTypes": "off"
  },
  "entry": [
    "app/initialize.tsx",
    // icons are looked up by name at runtime (ui/icons/SVG.tsx)
    "app/ui/icons/Icons/index.ts",
    // The private saas repo replaces or imports these by path, so they have
    // users this repo can't see. Regenerate the list when the overlay changes.
    "app/ThemeContext.tsx",
    "app/Tracker.tsx",
    "app/api_client.ts",
    "app/components/Auth/AuthScreen.tsx",
    "app/components/Auth/SignupPitch.tsx",
    "app/components/Client/Billing/Billing.tsx",
    "app/components/Client/Integrations/Backend/DatadogForm/DatadogFormModal.tsx",
    "app/components/Client/Integrations/Backend/DynatraceForm/DynatraceFormModal.tsx",
    "app/components/Client/Integrations/Backend/ElasticForm/ElasticFormModal.tsx",
    "app/components/Client/Integrations/Backend/SentryForm/SentryFormModal.tsx",
    "app/components/Client/Integrations/GithubForm.tsx",
    "app/components/Client/Integrations/Integrations.tsx",
    "app/components/Client/Integrations/JiraForm/index.js",
    "app/components/Client/Integrations/LinearForm.tsx",
    "app/components/Client/Integrations/MessengerForm.tsx",
    "app/components/Client/Integrations/ProfilerDoc/index.js",
    "app/components/Client/Integrations/SlackForm.tsx",
    "app/components/Client/Integrations/Teams/index.tsx",
    "app/components/Client/Integrations/Tracker/AssistDoc/index.js",
    "app/components/Client/Integrations/Tracker/GraphQLDoc/index.js",
    "app/components/Client/Integrations/Tracker/MobxDoc/index.js",
    "app/components/Client/Integrations/Tracker/NgRxDoc/index.js",
    "app/components/Client/Integrations/Tracker/PiniaDoc/index.js",
    "app/components/Client/Integrations/Tracker/ReduxDoc/index.js",
    "app/components/Client/Integrations/Tracker/VueDoc/index.js",
    "app/components/Client/Integrations/Tracker/ZustandDoc/index.js",
    "app/components/Client/PrefSection.tsx",
    "app/components/Client/PreferencesPage.tsx",
    "app/components/Client/ProfileSettings/Dangerzone.tsx",
    "app/components/Header/DefaultMenuView/Version.tsx",
    "app/components/Login/Login.tsx",
    "app/components/Modal/index.tsx",
    "app/components/ModalContext.tsx",
    "app/components/Session_/Player/Controls/SummaryButton.tsx",
    "app/components/Signup/Signup.tsx",
    "app/components/Signup/SignupForm/index.ts",
    "app/components/Spots/SpotsList/InstallCTA.tsx",
    "app/components/Survey/Survey.tsx",
    "app/components/hocs/withPageTitle.jsx",
    "app/components/shared/CodeSnippet/url.ts",
    "app/components/shared/DevTools/ExplainButton.tsx",
    "app/components/shared/DevTools/NetworkPanel/hasExplainAi.ts",
    "app/components/shared/DocCard/DocCard.tsx",
    "app/components/shared/MDRenderer/MDRenderer.tsx",
    "app/components/shared/RecordingsMeter/RecordingsMeter.tsx",
    "app/date.ts",
    "app/dateRange.js",
    "app/init/openreplay.ts",
    "app/layout/CrispIframe.tsx",
    "app/layout/HeaderBanners.tsx",
    "app/layout/LangBanner.tsx",
    "app/lib/utils.ts",
    "app/mstore/billingStore.ts",
    "app/mstore/index.tsx",
    "app/mstore/integrationsStore.ts",
    "app/routes.ts",
    "app/routing/index.ts",
    "app/services/BaseService.ts",
    "app/services/BillingService.ts",
    "app/services/index.ts",
    "app/types/app/period.js",
    "app/ui/actions/IconButton.tsx",
    "app/ui/actions/button.tsx",
    "app/ui/data/Chip.tsx",
    "app/ui/data/ProgressBar.tsx",
    "app/ui/data/StatTile.tsx",
    "app/ui/data/table.tsx",
    "app/ui/feedback/Banner.tsx",
    "app/ui/feedback/EmptyState.tsx",
    "app/ui/feedback/Loader.tsx",
    "app/ui/feedback/Notice.tsx",
    "app/ui/feedback/SkeletonRows.tsx",
    "app/ui/icons/Icon.tsx",
    "app/ui/inputs/DateRange.tsx",
    "app/ui/inputs/Field.tsx",
    "app/ui/inputs/input.tsx",
    "app/ui/inputs/password-input.tsx",
    "app/ui/inputs/switch.tsx",
    "app/ui/layout/ListFooter.tsx",
    "app/ui/overlays/ConfirmDialog.tsx",
    "app/ui/overlays/EntityDrawer.tsx",
    "app/ui/overlays/confirm.tsx",
    "app/ui/overlays/modal.tsx",
    "app/ui/overlays/toast.tsx",
    "app/ui/overlays/tooltip.tsx",
    "app/ui/styles/token-values.ts",
    "app/utils/extraUtils.ts",
    "app/utils/index.ts",
    "app/utils/planFeatures.ts",
    "app/utils/split-utils.ts",
    "app/withRecaptcha.tsx",
    "env.ts",
    "saas/audits/AuditsPage.tsx",
    "saas/billing/PayAsYouGo.tsx",
    "saas/layout/AppBanners.tsx",
    "saas/nav/RecordingsMeter.tsx"
  ],
  "project": ["app/**/*.{ts,tsx,js,jsx}"],
  "ignoreExportsUsedInFile": true,
  "ignore": [
    // translation key extractor, run by hand
    "app/locales/extractTranslations.js",
    // old kit, still imported by saas main
    "app/components/ui/**",
    // return-null placeholder the saas build may fill
    "app/components/Session_/SimilarSessions/SimilarSessionsButton.tsx"
  ]
}
