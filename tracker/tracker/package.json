{
  "name": "@openreplay/tracker",
  "description": "The OpenReplay tracker main package",
  "version": "19.0.0-beta.0",
  "keywords": [
    "logging",
    "replay"
  ],
  "author": "Alex Tsokurov",
  "contributors": [
    "Aleksandr K <alex@openreplay.com>",
    "Nikita D <nikita@openreplay.com>"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/entry.d.ts",
        "default": "./dist/lib/entry.js"
      },
      "require": {
        "types": "./dist/cjs/entry.d.ts",
        "default": "./dist/cjs/entry.js"
      }
    },
    "./class": {
      "import": {
        "types": "./dist/lib/index.d.ts",
        "default": "./dist/lib/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./cjs": {
      "types": "./dist/cjs/entry.d.ts",
      "default": "./dist/cjs/entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/lib/**/*",
    "dist/cjs/**/*"
  ],
  "main": "./dist/cjs/entry.js",
  "module": "./dist/lib/entry.js",
  "types": "./dist/lib/entry.d.ts",
  "typesVersions": {
    "*": {
      "class": [
        "./dist/lib/index.d.ts"
      ],
      "cjs": [
        "./dist/cjs/entry.d.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint src --ext .ts,.js --fix --quiet",
    "clean": "rm -Rf build && rm -Rf dist",
    "build:common": "tsc -b src/common",
    "compile": "tsc --project src/main/tsconfig.json",
    "build:types": "rollup --config rollup.dts.config.js",
    "create-types": "mkdir -p dist/lib dist/cjs && printf '{\\n  \"type\": \"commonjs\"\\n}\\n' > dist/cjs/package.json && bun run build:types && cp dist/lib/entry.d.ts dist/lib/index.d.ts dist/cjs/",
    "build": "bun run clean && bun run compile && rollup --config rollup.config.js && bun run create-types",
    "build:fast": "bun run compile && rollup --config rollup.config.js && bun run create-types",
    "test": "jest --coverage=false",
    "test:ci": "jest --coverage=true",
    "test:types": "tsc --noEmit --project tests-dts/tsconfig.json",
    "test:pack": "attw --pack . --ignore-rules cjs-only-exports-default",
    "postversion": "bun run build",
    "prepublishOnly": "bun run test && bun run build && bun run test:types && node tests-dts/require.cjs && bun run test:pack"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@jest/globals": "^30.4.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "babel-jest": "^30.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "rollup": "^4.62.3",
    "rollup-plugin-dts": "^6.5.1",
    "semver": "^6.3.0",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@openreplay/network-proxy": "^1.2.5",
    "error-stack-parser-es": "2.0.1",
    "web-vitals": "^5.3.0"
  },
  "engines": {
    "node": ">=14.0"
  },
  "packageManager": "bun@1.2.7"
}
