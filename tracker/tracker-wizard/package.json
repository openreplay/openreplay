{
  "name": "@openreplay/wizard",
  "version": "0.1.0",
  "description": "Interactive setup for the OpenReplay web tracker: detects the framework, installs the packages and wires the tracker in",
  "keywords": [
    "openreplay",
    "session replay",
    "setup",
    "wizard"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "openreplay-wizard": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openreplay/openreplay.git",
    "directory": "tracker/tracker-wizard"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --format=esm --outfile=dist/index.js --banner='#!/usr/bin/env node'",
    "dev": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "playground": "node scripts/playground.mjs up",
    "playground:reset": "node scripts/playground.mjs reset",
    "playground:down": "node scripts/playground.mjs down"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@clack/prompts": "^1.9.0",
    "@types/bun": "^1.3.0",
    "@types/node": "^24",
    "typescript": "^5.9.3"
  }
}
