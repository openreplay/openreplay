exports[`React + Vite plan: config module, entry import, RTK middleware 1`] = `
"// OpenReplay tracker docs: https://docs.openreplay.com/en/sdk/
// Docs for agents: @openreplay/tracker/docs/usage.md and @openreplay/tracker/docs/api.md
import { tracker } from '@openreplay/tracker'
import trackerAssist from '@openreplay/tracker-assist'
import trackerRedux from '@openreplay/tracker-redux'

tracker.configure({
  projectKey: 'KEY123',
  ingestPoint: 'https://or.example.com/ingest',
  __DISABLE_SECURE_MODE: import.meta.env.DEV, // record on http://localhost while developing
  network: {
    capturePayload: true,
    // tracker 19's types want every network field
    failuresOnly: false,
    ignoreHeaders: ['cookie', 'set-cookie', 'authorization'],
    sessionTokenHeader: false,
    captureInIframes: true,
  },
})

tracker.use(trackerAssist())
export const openReplayMiddleware = tracker.use(trackerRedux())

tracker.start()
"
`;

