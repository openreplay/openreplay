{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "ignoreDeps": [
    "docker.io/bitnamilegacy/bitnami-shell",
    "docker.io/bitnamilegacy/kafka-exporter",
    "docker.io/bitnamilegacy/redis-sentinel-exporter"
  ],
  "enabledManagers": [
    "helmv3",
    "dockerfile",
    "helm-values",
    "docker-compose",
    "github-actions",
    "helm-requirements",
    "npm"
  ],
  "packageRules": [
    {
      "description": "JS dependencies: security fixes only, no routine update PRs.",
      "matchManagers": ["npm"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
