{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": ["main", "dev"],
  "ignoreDeps": [
    "docker.io/bitnamilegacy/bitnami-shell",
    "docker.io/bitnamilegacy/kafka-exporter",
    "docker.io/bitnamilegacy/redis-sentinel-exporter"
  ],
  "enabledManagers": [
    "helmv3",
    "dockerfile",
    "helm-values",
    "docker-compose",
    "github-actions",
    "helm-requirements",
    "npm",
    "custom.regex"
  ],
  "customManagers": [
    {
      "description": "nginx-ingress controller tag; the image repository is only set in the subchart, so helm-values cannot see it.",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts/helmcharts/openreplay/values\\.yaml$/"],
      "matchStrings": ["ingress-nginx:\\s*\\n(?:.*\\n)*?\\s+controller:\\s*\\n\\s+image:\\s*\\n\\s+tag:\\s*[\"']?(?<currentValue>[^\\s\"']+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "nginx/nginx-ingress",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "JS dependencies: security fixes only, no routine update PRs.",
      "matchManagers": ["npm"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  }
}
